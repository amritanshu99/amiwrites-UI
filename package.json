{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/server": "2.0.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@tiptap/react": "^2.12.0",
    "@tiptap/starter-kit": "^2.12.0",
    "axios": "^1.9.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.15.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-ga4": "^2.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.1",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "sitemap": "^8.0.0",
    "web-vitals": "^2.1.4",
    "zod": "4.6.5"
  },
  "scripts": {
    "generate:loader": "node scripts/generate-initial-loader.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "generate-seo-pages": "node scripts/generate-seo-pages.js",
    "prestart": "npm run generate:loader",
    "start": "react-scripts start",
    "prebuild": "npm run generate:loader",
    "build": "npm run generate-sitemap && react-scripts build && npm run generate-seo-pages",
    "test": "react-scripts test",
    "test:loader": "node --test scripts/generate-initial-loader.test.js",
    "test:seo": "node --test server/seoContent.test.js scripts/generate-seo-pages.test.js",
    "eject": "react-scripts eject",
    "mcp:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/mcp/local.js",
    "mcp:inspect": "npx --yes @modelcontextprotocol/inspector@2.7.0 --web",
    "mcp:smoke": "node scripts/mcp-smoke.js",
    "test:mcp": "node --test server/mcp/tests/*.test.js",
    "lint:mcp": "eslint server/mcp api/mcp.js api/mcp-health.js api/mcp-verification.js scripts/mcp-smoke.js",
    "lint": "eslint src server api scripts --ext .js,.jsx --ignore-pattern **/*.test.*",
    "lint:all": "eslint src server api scripts --ext .js,.jsx"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": "24.x"
  }
}
