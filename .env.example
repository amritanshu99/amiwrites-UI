# Frontend API origin (no trailing slash)
REACT_APP_API_URL=http://localhost:5000

# Public OAuth 2.0 Web client ID from Google Cloud Console
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Amiverse MCP (server-side only; never prefix these with REACT_APP_)
MCP_CONTENT_API_ORIGIN=https://amiwrites-backend-app-2lp5.onrender.com
MCP_PORT=8787
# Maximum 10000 ms per upstream operation; keeps cold detail calls within Vercel duration.
MCP_UPSTREAM_TIMEOUT_MS=8000
# Absolute body-read deadline, at most 5000 ms.
MCP_BODY_TIMEOUT_MS=5000
MCP_CACHE_SECONDS=60
# Coarse requests/minute per process; add a Vercel Firewall rule for fleet-wide control.
MCP_RATE_LIMIT=120
# Exact VERCEL_URL / VERCEL_BRANCH_URL hosts are added when VERCEL=1.
# Add other exact preview/tunnel hosts here if system variables are unavailable.
MCP_ALLOWED_HOSTS=www.amiverse.in,amiverse.in,mcp.amiverse.in,localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://www.amiverse.in,https://amiverse.in,http://localhost:6274,http://127.0.0.1:6274
# Exact token from the OpenAI plugin submission portal (leave unset before submission).
OPENAI_APPS_CHALLENGE_TOKEN=
